  <Import Project="..\..\src\Microsoft.VisualStudio.Extensibility.Testing.Xunit.Shared\build\Microsoft.VisualStudio.Extensibility.Testing.Xunit.targets"/>

  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
